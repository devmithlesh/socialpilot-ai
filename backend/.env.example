# ═══════════════════════════════════════════════════════════════════════
# SocialPilot AI — Environment Variables
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3001

# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/socialpilot_ai?schema=public"

# ─── Authentication ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_MINIMUM_32_CHARACTER_RANDOM_SECRET
JWT_EXPIRES_IN=7d
# ─── Encryption ─────────────────────────────────────────────────────────────
# Used to AES-256-GCM encrypt OAuth tokens at rest. Must be exactly 32 chars.
# Generate with: openssl rand -base64 24 | head -c 32
ENCRYPTION_KEY=REPLACE_WITH_EXACTLY_32_CHARACTERS!!

# ─── Frontend ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── OpenAI ChatGPT ─────────────────────────────────────────────────────────
# Get your API key from: https://platform.openai.com/api-keys
# Leave empty to disable AI generation (all other features still work)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Model used to generate post images (Images API)
OPENAI_IMAGE_MODEL=gpt-image-2

# ─── LinkedIn OAuth ─────────────────────────────────────────────────────────
# Create a LinkedIn app at: https://developer.linkedin.com/
# Required permissions: openid, profile, email, w_member_social
# Your app must be approved for Marketing Developer Platform access
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5173/oauth/linkedin/callback

# ─── Instagram / Meta OAuth ─────────────────────────────────────────────────
# Create a Meta app at: https://developers.facebook.com/
# Required: instagram_basic, instagram_content_publish permissions
# User must have an Instagram Professional account connected to a Facebook Page
# App must be in Live mode for external users
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5173/oauth/instagram/callback

# ─── Business Logic ─────────────────────────────────────────────────────────
# Hours after which an unused approval expires (default: 24)
APPROVAL_EXPIRY_HOURS=24

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
MAX_UPLOAD_SIZE_MB=10
